---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
	<section class="hero">
		<h1>Reflection Network</h1>
		<p class="tagline">Become the founder of your AI-native company</p>
		<p class="description">Create, deploy, and manage a team of AI agents. Your agents. Your infrastructure. Your rules.</p>

		<div class="cta">
			<a href="https://docs.reflection.network" class="button">Get Started</a>
			<a href="https://github.com/reflection-network" class="button button-secondary">GitHub</a>
			<a href="https://x.com/reflection_dev" class="button button-secondary">Twitter</a>
		</div>
	</section>

	<section class="highlights">
		<div class="highlight">
			<h3>Declarative agents.</h3>
			<p>Nix config, no SDK lock-in.</p>
		</div>
		<div class="highlight">
			<h3>Git-native.</h3>
			<p>Branch, fork, version, roll back.</p>
		</div>
		<div class="highlight">
			<h3>Run anywhere.</h3>
			<p>Self-host, swap runtimes with one line.</p>
		</div>
	</section>

	<section class="code-example">
		<pre><code>{`{
  inputs.agent-nix.url = "github:reflection-network/agent.nix";

  outputs = { self, agent-nix }:
    agent-nix.lib.mkAgent {
      agent = {
        name = "Agent";
        system-prompt = "You are Agent, a helpful assistant.";
      };
    };
}`}</code></pre>
	</section>
</BaseLayout>

<style>
	.hero {
		text-align: center;
		padding: 4rem 0 3rem 0;
	}

	h1 {
		font-size: 3rem;
		font-weight: 700;
		margin: 0 0 1rem 0;
		letter-spacing: -0.02em;
	}

	.tagline {
		font-size: 1.25rem;
		color: rgba(224, 224, 224, 0.7);
		margin: 0 0 0.5rem 0;
	}

	.description {
		font-size: 1rem;
		color: rgba(224, 224, 224, 0.45);
		margin: 0 0 2rem 0;
	}

	.cta {
		margin: 0 auto;
		display: flex;
		justify-content: center;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.button {
		display: inline-block;
		padding: 0.75rem 2rem;
		background: rgba(224, 224, 224, 0.08);
		border: 1px solid rgba(224, 224, 224, 0.2);
		border-radius: 6px;
		color: #e0e0e0;
		text-decoration: none;
		font-size: 1rem;
		transition: background 0.2s, border-color 0.2s;
	}

	.button:hover {
		background: rgba(224, 224, 224, 0.15);
		border-color: rgba(224, 224, 224, 0.35);
	}

	.button-secondary {
		background: transparent;
		border-color: rgba(224, 224, 224, 0.12);
	}

	.highlights {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 3rem;
	}

	.highlight {
		padding: 0.75rem 0 0.75rem 1.25rem;
		border-left: 2px solid rgba(224, 224, 224, 0.2);
	}

	.highlight h3 {
		font-size: 1rem;
		font-weight: 600;
		margin: 0 0 0.25rem 0;
		color: #e0e0e0;
	}

	.highlight p {
		font-size: 0.95rem;
		color: rgba(224, 224, 224, 0.45);
		margin: 0;
		line-height: 1.5;
	}

	.code-example {
		margin: 0 auto 3rem auto;
	}

	.code-example pre {
		background: rgba(0, 0, 0, 0.4);
		border: 1px solid rgba(224, 224, 224, 0.12);
		border-radius: 8px;
		padding: 1.25rem 1.5rem;
		text-align: left;
		overflow-x: auto;
	}

	.code-example code {
		font-family: 'SF Mono', 'Fira Code', 'Fira Mono', monospace;
		font-size: 0.85rem;
		color: rgba(224, 224, 224, 0.7);
		line-height: 1.5;
	}

	@media (max-width: 600px) {
		h1 {
			font-size: 2rem;
		}
		.tagline {
			font-size: 1rem;
		}
		.hero {
			padding: 2rem 0;
		}
	}
</style>
